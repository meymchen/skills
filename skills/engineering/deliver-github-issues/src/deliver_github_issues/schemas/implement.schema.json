{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["status", "summary", "usedSkills", "tests", "blockers"],
  "properties": {
    "status": { "enum": ["completed", "blocked"] },
    "summary": { "type": "string" },
    "usedSkills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tests": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["command", "exitCode"],
        "properties": { "command": { "type": "string" }, "exitCode": { "type": "integer" } }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
