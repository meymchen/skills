{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "repository", "baseBranch", "policy", "issues", "index", "phase", "current", "updatedAt"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "baseBranch": { "type": "string", "minLength": 1 },
    "policy": { "type": "object" },
    "issues": { "type": "array", "minItems": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "phase": {
      "enum": ["preflight", "prepare", "implement", "needs_implementation", "local_gates", "publish", "ci", "audit", "awaiting_human", "merge", "complete"]
    },
    "current": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number", "title", "branch", "issueUpdatedAt", "issueUrl", "checkboxes", "testedSha", "implementation", "localChecks", "ciChecks", "prNumber", "prUrl", "audit", "metadata"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "branch": { "type": "string" },
        "issueUpdatedAt": { "type": "string" },
        "issueUrl": { "type": "string" },
        "checkboxes": { "type": "array" },
        "testedSha": { "type": ["string", "null"] },
        "implementation": { "type": ["object", "null"] },
        "localChecks": { "type": "array" },
        "ciChecks": { "type": "array" },
        "prNumber": { "type": ["integer", "null"] },
        "prUrl": { "type": ["string", "null"] },
        "audit": { "type": ["object", "null"] },
        "metadata": { "type": ["object", "null"] }
      }
    },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
