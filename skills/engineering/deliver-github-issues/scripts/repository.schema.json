{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "readyLabel", "branchPrefix", "ciTimeoutMinutes", "localChecks", "requiredChecks", "primaryAgent", "metadataAgent"],
  "properties": {
    "version": { "const": 1 },
    "readyLabel": { "type": "string", "minLength": 1 },
    "branchPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "ciTimeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "localChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "arguments"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "arguments": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "primaryAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "enum": ["codex", "claude"] },
        "model": { "type": "string" }
      }
    },
    "metadataAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "fallback"],
      "properties": {
        "provider": { "enum": ["deterministic", "codex", "opencode", "copilot", "kimi"] },
        "model": { "type": "string" },
        "fallback": { "type": "boolean" }
      }
    }
  }
}
