{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["summary", "criteria"],
  "properties": {
    "summary": { "type": "string" },
    "criteria": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["index", "text", "status", "evidence"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 }, "text": { "type": "string" },
          "status": { "enum": ["satisfied", "unsatisfied", "human_required"] },
          "evidence": { "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "value"],
            "properties": { "kind": { "enum": ["file", "command", "ci"] }, "value": { "type": "string" } }
          } }
        }
      }
    }
  }
}
